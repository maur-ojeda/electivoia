{# templates/guardian/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mis Pupilos — ElectivoIA{% endblock %}

{% block content %}
<div class="mb-6">
	<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Mis Pupilos</h1>
</div>

{% if pupils|length == 0 %}
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-12 text-center">
		<p class="text-gray-500 dark:text-gray-400">No tienes pupilos asignados.</p>
	</div>
{% else %}
	<div class="space-y-8">
		{% for pupil in pupils %}
			{% set enrollments = pupilEnrollments[pupil.id] ?? [] %}
			{% set attendanceByPupil = pupilAttendance[pupil.id] ?? {} %}

			<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
				<h2 class="font-bold text-lg text-gray-900 dark:text-white mb-1">{{ pupil.fullName }}</h2>
				<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">{{ pupil.grade }} — Promedio: {{ pupil.averageGrade ?? 'N/A' }}</p>

				{% if enrollments|length == 0 %}
					<p class="text-sm text-gray-500 dark:text-gray-400">Sin cursos inscritos.</p>
				{% else %}
					<div class="space-y-3">
						{% for enrollment in enrollments %}
							{% set courseId = enrollment.course.id %}
							{% set att = attendanceByPupil[courseId] ?? null %}
							{% set borderColor = (att is null or att.total == 0) ? 'border-gray-200 dark:border-gray-700' : (att.percentage >= 75 ? 'border-green-500' : (att.percentage >= 50 ? 'border-yellow-400' : 'border-red-500')) %}

							<div class="border-l-4 {{ borderColor }} bg-gray-50 dark:bg-gray-700 rounded-r-lg p-3">
								<div class="flex justify-between items-center">
									<div>
										<p class="font-medium text-sm text-gray-900 dark:text-white">{{ enrollment.course.name }}</p>
										{% if enrollment.course.teacher %}
											<p class="text-xs text-gray-500 dark:text-gray-400">Prof. {{ enrollment.course.teacher.fullName }}</p>
										{% endif %}
										{% if enrollment.course.schedule %}
											<p class="text-xs text-gray-400 dark:text-gray-500">🕐 {{ enrollment.course.schedule }}</p>
										{% endif %}
									</div>
									<div class="text-right">
										{% if att is not null and att.total > 0 %}
											{% set pctColor = att.percentage >= 75 ? 'text-green-600 dark:text-green-400' : (att.percentage >= 50 ? 'text-yellow-500' : 'text-red-600 dark:text-red-400') %}
											<span class="font-bold text-lg {{ pctColor }}">{{ att.percentage }}%</span>
											<p class="text-xs text-gray-400 dark:text-gray-500">{{ att.attended }}/{{ att.total }} sesiones</p>
										{% else %}
											<span class="text-xs text-gray-400 dark:text-gray-500">Sin sesiones</span>
										{% endif %}
									</div>
								</div>

								{% if att is not null and att.records|length > 0 %}
									<details class="mt-2">
										<summary class="cursor-pointer text-xs text-blue-600 hover:underline dark:text-blue-400">
											Ver detalle ({{ att.total }} sesiones)
										</summary>
										<div class="mt-2 overflow-x-auto">
											<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
												<thead class="bg-gray-100 dark:bg-gray-600">
													<tr>
														<th class="px-2 py-1">Fecha</th>
														<th class="px-2 py-1">Estado</th>
													</tr>
												</thead>
												<tbody>
													{% for record in att.records %}
														<tr class="border-t dark:border-gray-600">
															<td class="px-2 py-1">{{ record.date|date('d/m/Y') }}</td>
															<td class="px-2 py-1">
																{% if record.status == 'present' %}
																	<span class="text-green-700 dark:text-green-400">Presente</span>
																{% elseif record.status == 'absent' %}
																	<span class="text-red-700 dark:text-red-400">Ausente</span>
																{% else %}
																	<span class="text-yellow-600 dark:text-yellow-400">Justificado</span>
																{% endif %}
															</td>
														</tr>
													{% endfor %}
												</tbody>
											</table>
										</div>
									</details>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		{% endfor %}
	</div>
{% endif %}
{% endblock %}
