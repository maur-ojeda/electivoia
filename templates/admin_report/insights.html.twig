{% extends 'base.html.twig' %}
{% block title %}Insights IA — ElectivoIA{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-6">
	<a href="{{ path('admin_reports_index') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">← Volver</a>
	<div>
		<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Insights Generados por IA</h1>
		<p class="text-sm text-gray-500 dark:text-gray-400">Análisis del estado actual de inscripciones, generado con Gemini.</p>
	</div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

	<div class="lg:col-span-1 space-y-4">
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow">
			<div class="divide-y divide-gray-200 dark:divide-gray-700">
				<div class="p-4">
					<p class="text-xs text-gray-500 dark:text-gray-400">Cursos activos</p>
					<p class="text-3xl font-bold text-blue-600 dark:text-blue-400">{{ stats.total_courses }}</p>
				</div>
				<div class="p-4">
					<p class="text-xs text-gray-500 dark:text-gray-400">Total inscripciones</p>
					<p class="text-3xl font-bold text-purple-600 dark:text-purple-400">{{ stats.total_enrolled }}</p>
				</div>
				<div class="p-4">
					<p class="text-xs text-gray-500 dark:text-gray-400">Ocupación promedio</p>
					<p class="text-3xl font-bold {{ stats.avg_occupancy >= 70 ? 'text-green-600 dark:text-green-400' : (stats.avg_occupancy >= 40 ? 'text-yellow-500' : 'text-red-600 dark:text-red-400') }}">
						{{ stats.avg_occupancy }}%
					</p>
				</div>
			</div>
		</div>

		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
			<h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">Inscripciones por área</h2>
			<ul class="space-y-1">
				{% for cat, count in stats.by_category %}
					<li class="flex justify-between text-sm">
						<span class="truncate text-gray-600 dark:text-gray-400">{{ cat }}</span>
						<span class="font-bold ml-2 text-gray-900 dark:text-white">{{ count }}</span>
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="lg:col-span-2">
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
			<div class="flex items-center gap-2 mb-4">
				<span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-green-900 dark:text-green-300">IA</span>
				<h2 class="text-base font-semibold text-gray-900 dark:text-white">Análisis en lenguaje natural</h2>
			</div>
			<ul class="space-y-3">
				{% for insight in aiInsights %}
					<li class="flex gap-3 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg text-sm leading-relaxed">
						<span class="text-green-600 dark:text-green-400 mt-0.5 shrink-0">✦</span>
						<span class="text-gray-700 dark:text-gray-300">{{ insight|replace({'- ': ''})|trim }}</span>
					</li>
				{% endfor %}
			</ul>
			<p class="text-xs text-gray-400 dark:text-gray-500 mt-4">Generado automáticamente · Actualizar para ver el análisis más reciente.</p>
			<div class="flex gap-3 mt-3">
				<a href="{{ path('admin_reports_insights') }}"
					class="text-white bg-green-600 hover:bg-green-700 font-medium rounded-lg text-sm px-4 py-2 dark:bg-green-700 dark:hover:bg-green-600">
					Regenerar análisis
				</a>
				<a href="{{ path('admin_reports_low_enrollment') }}"
					class="text-yellow-700 bg-yellow-50 border border-yellow-300 hover:bg-yellow-100 font-medium rounded-lg text-sm px-4 py-2 dark:bg-yellow-900/30 dark:text-yellow-300 dark:border-yellow-600">
					Ver alertas
				</a>
			</div>
		</div>
	</div>

</div>
{% endblock %}
