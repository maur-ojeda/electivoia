{% extends 'base.html.twig' %}
{% block title %}Reporte Comparativo — Admin{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
	<div>
		<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Reporte Comparativo</h1>
		<p class="text-sm text-gray-500 dark:text-gray-400">Inscripciones por grado y categoría de curso.</p>
	</div>
	<div class="flex gap-2">
		<a href="{{ path('admin_reports_comparative_export') }}"
			class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-4 py-2 flex items-center gap-2 dark:bg-gray-700 dark:text-white dark:border-gray-600 dark:hover:bg-gray-600">
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
			Exportar Excel
		</a>
		<a href="{{ path('admin_reports_index') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">← Reportes</a>
	</div>
</div>

{% if categories|length == 0 %}
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-12 text-center">
		<p class="text-gray-500 dark:text-gray-400">No hay inscripciones en cursos activos aún.</p>
	</div>
{% else %}
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-x-auto mb-6">
		<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
			<thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-400">
				<tr>
					<th class="px-4 py-3 font-bold">Grado</th>
					{% for cat in categories %}
						<th class="px-4 py-3 text-center font-medium">{{ cat }}</th>
					{% endfor %}
					<th class="px-4 py-3 text-center font-bold">Total</th>
				</tr>
			</thead>
			<tbody>
				{% for grade in grades %}
					{% set rowTotal = 0 %}
					<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
						<td class="px-4 py-3 font-bold text-gray-900 dark:text-white">
							{{ grade == '3M' ? 'Tercer Medio' : 'Cuarto Medio' }}
							<span class="bg-gray-100 text-gray-700 text-xs ml-1 px-1.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300">{{ grade }}</span>
						</td>
						{% for cat in categories %}
							{% set val = matrix[grade][cat] ?? 0 %}
							{% set rowTotal = rowTotal + val %}
							<td class="px-4 py-3 text-center">
								{% if val > 0 %}
									<span class="bg-blue-100 text-blue-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">{{ val }}</span>
								{% else %}
									<span class="text-gray-300 dark:text-gray-600">—</span>
								{% endif %}
							</td>
						{% endfor %}
						<td class="px-4 py-3 text-center">
							<span class="bg-gray-700 text-white text-xs font-medium px-2 py-0.5 rounded dark:bg-gray-600">{{ rowTotal }}</span>
						</td>
					</tr>
				{% endfor %}
			</tbody>
			<tfoot>
				<tr class="bg-gray-100 dark:bg-gray-700 font-bold">
					<td class="px-4 py-3 text-gray-900 dark:text-white">Total</td>
					{% set grandTotal = 0 %}
					{% for cat in categories %}
						{% set colTotal = totals[cat] ?? 0 %}
						{% set grandTotal = grandTotal + colTotal %}
						<td class="px-4 py-3 text-center">
							<span class="text-xs font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-500 px-2 py-0.5 rounded">{{ colTotal }}</span>
						</td>
					{% endfor %}
					<td class="px-4 py-3 text-center">
						<span class="bg-gray-700 text-white text-sm font-bold px-2.5 py-0.5 rounded dark:bg-gray-600">{{ grandTotal }}</span>
					</td>
				</tr>
			</tfoot>
		</table>
	</div>

	{% set grandTotal = 0 %}
	{% for cat in categories %}{% set grandTotal = grandTotal + (totals[cat] ?? 0) %}{% endfor %}

	{% if grandTotal > 0 %}
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
			<h3 class="font-semibold text-gray-900 dark:text-white mb-4">Distribución por categoría</h3>
			<div class="space-y-3">
				{% for cat in categories %}
					{% set total = totals[cat] ?? 0 %}
					{% set pct = grandTotal > 0 ? (total / grandTotal * 100)|round : 0 %}
					<div>
						<div class="flex justify-between text-sm mb-1">
							<span class="font-medium text-gray-900 dark:text-white">{{ cat }}</span>
							<span class="text-gray-500 dark:text-gray-400">{{ total }} inscripciones ({{ pct }}%)</span>
						</div>
						<div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
							<div class="bg-blue-600 h-2.5 rounded-full" style="width: {{ pct }}%"></div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}
{% endif %}
{% endblock %}
