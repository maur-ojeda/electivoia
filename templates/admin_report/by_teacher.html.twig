{% extends 'base.html.twig' %}
{% block title %}Cursos por Profesor — ElectivoIA{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-6">
	<a href="{{ path('admin_reports_index') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">← Volver</a>
	<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Cursos por Profesor</h1>
</div>

{% if byTeacher|length == 0 %}
	<div class="text-center py-16 text-gray-400 dark:text-gray-500">No hay cursos registrados.</div>
{% else %}
	<div class="space-y-6">
		{% for item in byTeacher %}
			{% set teacher = item.teacher %}
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5">
				<div class="flex items-center justify-between flex-wrap gap-3 mb-4">
					<div>
						<h2 class="text-lg font-bold text-gray-900 dark:text-white">
							{{ teacher ? teacher.fullName : 'Sin profesor asignado' }}
						</h2>
						{% if teacher and teacher.email %}
							<p class="text-xs text-gray-500 dark:text-gray-400">{{ teacher.email }}</p>
						{% endif %}
					</div>
					<div class="flex gap-6 text-sm">
						<div class="text-center">
							<p class="text-xs text-gray-500 dark:text-gray-400">Cursos</p>
							<p class="text-xl font-bold text-gray-900 dark:text-white">{{ item.courses|length }}</p>
						</div>
						<div class="text-center">
							<p class="text-xs text-gray-500 dark:text-gray-400">Total inscritos</p>
							<p class="text-xl font-bold text-gray-900 dark:text-white">{{ item.totalEnrolled }}</p>
						</div>
					</div>
				</div>

				<div class="overflow-x-auto">
					<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
						<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
							<tr>
								<th class="px-3 py-3">Curso</th>
								<th class="px-3 py-3">Horario</th>
								<th class="px-3 py-3">Grados</th>
								<th class="px-3 py-3">Inscritos / Cupo</th>
								<th class="px-3 py-3">Estado</th>
							</tr>
						</thead>
						<tbody>
							{% for course in item.courses %}
								<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
									<td class="px-3 py-3 font-medium text-gray-900 dark:text-white">{{ course.name }}</td>
									<td class="px-3 py-3 text-xs">{{ course.schedule ?? '—' }}</td>
									<td class="px-3 py-3">
										<div class="flex gap-1 flex-wrap">
											{% for grade in (course.targetGrades ?? []) %}
												<span class="bg-gray-100 text-gray-700 text-xs px-1.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300">{{ grade }}</span>
											{% endfor %}
										</div>
									</td>
									<td class="px-3 py-3">
										<div class="flex items-center gap-2">
											<div class="w-20 bg-gray-200 rounded-full h-2 dark:bg-gray-700">
												<div class="bg-blue-600 h-2 rounded-full" style="width: {{ course.maxCapacity > 0 ? ((course.enrollments|length / course.maxCapacity) * 100)|round : 0 }}%"></div>
											</div>
											<span class="text-xs">{{ course.enrollments|length }}/{{ course.maxCapacity }}</span>
										</div>
									</td>
									<td class="px-3 py-3">
										{% if course.isActive %}
											<span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Activo</span>
										{% else %}
											<span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400">Inactivo</span>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endfor %}
	</div>
{% endif %}
{% endblock %}
