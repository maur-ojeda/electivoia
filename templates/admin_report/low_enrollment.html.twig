{% extends 'base.html.twig' %}
{% block title %}Alertas Baja Inscripción — ElectivoIA{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-6">
	<a href="{{ path('admin_reports_index') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">← Volver</a>
	<div>
		<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Alertas: Baja Inscripción</h1>
		<p class="text-sm text-gray-500 dark:text-gray-400">Cursos activos con menos del {{ threshold }}% de su cupo ocupado.</p>
	</div>
</div>

{% if alerts|length == 0 %}
	<div class="flex items-center p-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400" role="alert">
		<svg class="shrink-0 w-4 h-4 me-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
		</svg>
		Todos los cursos superan el {{ threshold }}% de ocupación. ¡Bien!
	</div>
{% else %}
	<div class="flex items-center p-4 mb-6 text-sm text-yellow-800 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-400" role="alert">
		<svg class="shrink-0 w-4 h-4 me-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-2.693-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
		</svg>
		{{ alerts|length }} curso(s) requieren atención.
	</div>

	<div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-x-auto mb-6">
		<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
			<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
				<tr>
					<th class="px-4 py-3">Curso</th>
					<th class="px-4 py-3">Profesor</th>
					<th class="px-4 py-3">Horario</th>
					<th class="px-4 py-3">Inscritos / Cupo</th>
					<th class="px-4 py-3">Ocupación</th>
					<th class="px-4 py-3">Fecha límite</th>
					<th class="px-4 py-3">Acciones</th>
				</tr>
			</thead>
			<tbody>
				{% for alert in alerts %}
					<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
						<td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{{ alert.course.name }}</td>
						<td class="px-4 py-3">{{ alert.course.teacher ? alert.course.teacher.fullName : '—' }}</td>
						<td class="px-4 py-3 text-xs">{{ alert.course.schedule ?? '—' }}</td>
						<td class="px-4 py-3">
							<div class="flex items-center gap-2">
								<div class="w-20 bg-gray-200 rounded-full h-2 dark:bg-gray-700">
									<div class="bg-yellow-400 h-2 rounded-full" style="width: {{ alert.capacity > 0 ? ((alert.enrolled / alert.capacity) * 100)|round : 0 }}%"></div>
								</div>
								<span class="text-xs">{{ alert.enrolled }}/{{ alert.capacity }}</span>
							</div>
						</td>
						<td class="px-4 py-3">
							<span class="bg-yellow-100 text-yellow-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">{{ alert.pct }}%</span>
						</td>
						<td class="px-4 py-3 text-xs">
							{{ alert.course.enrollmentDeadline ? alert.course.enrollmentDeadline|date('d/m/Y') : 'Sin límite' }}
						</td>
						<td class="px-4 py-3">
							<a href="{{ path('admin_enrollments_bulk') }}"
								class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 text-xs font-medium rounded-lg px-2.5 py-1.5 dark:bg-gray-700 dark:text-white dark:border-gray-600 dark:hover:bg-gray-600">
								Inscripción masiva
							</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg text-sm text-gray-600 dark:text-gray-400">
		<strong>Sugerencias:</strong> Comunica estos cursos mediante el
		<a href="{{ path('admin_email_blast') }}" class="text-blue-600 hover:underline dark:text-blue-400">envío masivo de email</a>,
		extiende la fecha límite de inscripción, o considera reducir el cupo mínimo requerido.
	</div>
{% endif %}
{% endblock %}
