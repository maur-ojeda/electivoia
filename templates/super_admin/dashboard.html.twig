{% extends 'base.html.twig' %}
{% block title %}Super Admin — ElectivoIA{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
	<div>
		<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Panel Super Admin</h1>
		<p class="text-sm text-gray-500 dark:text-gray-400">Gestión global de colegios en la plataforma</p>
	</div>
	<a href="{{ path('super_admin_onboard') }}"
		class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700">
		+ Nuevo colegio
	</a>
</div>

<div class="grid grid-cols-2 gap-4 mb-8">
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
		<p class="text-xs text-gray-500 dark:text-gray-400">Colegios activos</p>
		<p class="text-3xl font-bold text-blue-600 dark:text-blue-400">{{ totalSchools }}</p>
	</div>
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
		<p class="text-xs text-gray-500 dark:text-gray-400">Usuarios totales</p>
		<p class="text-3xl font-bold text-purple-600 dark:text-purple-400">{{ totalUsers }}</p>
	</div>
</div>

{% if schoolStats|length == 0 %}
	<div class="text-center py-16 text-gray-400 dark:text-gray-500">
		<p>No hay colegios registrados.</p>
		<a href="{{ path('super_admin_onboard') }}"
			class="mt-4 inline-block text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700">
			Registrar primer colegio
		</a>
	</div>
{% else %}
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-x-auto">
		<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
			<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
				<tr>
					<th class="px-4 py-3">Colegio</th>
					<th class="px-4 py-3">Slug</th>
					<th class="px-4 py-3">RBD</th>
					<th class="px-4 py-3">Plan</th>
					<th class="px-4 py-3">Usuarios</th>
					<th class="px-4 py-3">Estado</th>
					<th class="px-4 py-3">Inscripciones</th>
					<th class="px-4 py-3">Creado</th>
					<th class="px-4 py-3">Acciones</th>
				</tr>
			</thead>
			<tbody>
				{% for row in schoolStats %}
					{% set school = row.school %}
					<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
						<td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{{ school.name }}</td>
						<td class="px-4 py-3 text-xs">{{ school.slug }}</td>
						<td class="px-4 py-3 text-xs">{{ school.rbd ?? '—' }}</td>
						<td class="px-4 py-3">
							{% if school.plan == 'premium' %}
								<span class="bg-purple-100 text-purple-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-purple-900 dark:text-purple-300">{{ school.plan }}</span>
							{% elseif school.plan == 'basic' %}
								<span class="bg-blue-100 text-blue-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">{{ school.plan }}</span>
							{% else %}
								<span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400">{{ school.plan }}</span>
							{% endif %}
						</td>
						<td class="px-4 py-3">{{ row.users }}</td>
						<td class="px-4 py-3">
							{% if school.active %}
								<span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Activo</span>
							{% else %}
								<span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400">Inactivo</span>
							{% endif %}
						</td>
						<td class="px-4 py-3 text-xs">
							{% if school.enrollmentOpen %}
								<span class="text-green-600 dark:text-green-400 font-medium">Abierto</span>
							{% else %}
								<span class="text-yellow-500 font-medium">Cerrado</span>
							{% endif %}
							{% if school.enrollmentEnd %}
								<br><span class="text-gray-400 dark:text-gray-500">hasta {{ school.enrollmentEnd|date('d/m/Y') }}</span>
							{% endif %}
						</td>
						<td class="px-4 py-3 text-xs">{{ school.createdAt|date('d/m/Y') }}</td>
						<td class="px-4 py-3">
							<a href="{{ path('admin', {'menuIndex': 99}) }}"
								class="text-blue-600 hover:underline text-xs dark:text-blue-400">Editar</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endif %}
{% endblock %}
