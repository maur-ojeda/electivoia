{% extends 'base.html.twig' %}
{% block title %}Importar Estudiantes — Admin{% endblock %}

{% block content %}
<div class="mb-6">
	<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Importar Estudiantes desde CSV</h1>
	<p class="text-sm text-gray-500 dark:text-gray-400">Crea cuentas masivamente desde un archivo CSV al inicio del año escolar.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

	<div class="lg:col-span-1">
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 sticky top-20">
			<h3 class="font-semibold text-sm text-gray-900 dark:text-white mb-3">Formato del CSV</h3>
			<p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
				Primera fila = encabezado (ignorado). Separador: coma <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">,</code> o punto y coma <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">;</code>.
			</p>
			<div class="overflow-x-auto">
				<table class="w-full text-xs text-left text-gray-500 dark:text-gray-400">
					<thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
						<tr>
							<th class="px-2 py-1">Col</th>
							<th class="px-2 py-1">Campo</th>
							<th class="px-2 py-1">Req.</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-b dark:border-gray-700"><td class="px-2 py-1">1</td><td class="px-2 py-1">RUT</td><td class="px-2 py-1"><span class="bg-red-100 text-red-700 text-xs px-1 rounded dark:bg-red-900 dark:text-red-300">Sí</span></td></tr>
						<tr class="border-b dark:border-gray-700"><td class="px-2 py-1">2</td><td class="px-2 py-1">Nombre completo</td><td class="px-2 py-1"><span class="bg-red-100 text-red-700 text-xs px-1 rounded dark:bg-red-900 dark:text-red-300">Sí</span></td></tr>
						<tr class="border-b dark:border-gray-700"><td class="px-2 py-1">3</td><td class="px-2 py-1">Grado (3M / 4M)</td><td class="px-2 py-1"><span class="bg-red-100 text-red-700 text-xs px-1 rounded dark:bg-red-900 dark:text-red-300">Sí</span></td></tr>
						<tr class="border-b dark:border-gray-700"><td class="px-2 py-1">4</td><td class="px-2 py-1">Promedio (ej: 5.8)</td><td class="px-2 py-1"><span class="bg-gray-100 text-gray-700 text-xs px-1 rounded dark:bg-gray-700 dark:text-gray-400">No</span></td></tr>
						<tr><td class="px-2 py-1">5</td><td class="px-2 py-1">Email</td><td class="px-2 py-1"><span class="bg-gray-100 text-gray-700 text-xs px-1 rounded dark:bg-gray-700 dark:text-gray-400">No</span></td></tr>
					</tbody>
				</table>
			</div>
			<hr class="my-3 border-gray-200 dark:border-gray-700">
			<div class="text-xs space-y-1 text-gray-500 dark:text-gray-400">
				<p>• RUT formato: <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">12345678-9</code></p>
				<p>• Contraseña inicial = dígitos del RUT (sin guión)</p>
				<p>• Duplicados (mismo RUT) se omiten sin error</p>
				<p>• Rol asignado automáticamente: <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">ROLE_STUDENT</code></p>
			</div>
			<div class="mt-4">
				<p class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Ejemplo de fila:</p>
				<code class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 p-2 rounded block break-all">12345678-9,Juan Pérez,3M,6.2,juan@mail.com</code>
			</div>
		</div>
	</div>

	<div class="lg:col-span-2 space-y-6">

		{% if result is not null %}
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow border-l-4 {{ result.errors|length == 0 ? 'border-green-500' : 'border-yellow-400' }} p-4">
				<h3 class="font-semibold text-gray-900 dark:text-white mb-3">Resultado de la importación</h3>
				<div class="grid grid-cols-3 gap-3 mb-3">
					<div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-center">
						<p class="text-xs text-gray-500 dark:text-gray-400">Creados</p>
						<p class="text-2xl font-bold text-green-600 dark:text-green-400">{{ result.created }}</p>
					</div>
					<div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-center">
						<p class="text-xs text-gray-500 dark:text-gray-400">Duplicados</p>
						<p class="text-2xl font-bold text-yellow-500">{{ result.duplicates }}</p>
					</div>
					<div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-center">
						<p class="text-xs text-gray-500 dark:text-gray-400">Errores</p>
						<p class="text-2xl font-bold text-red-600 dark:text-red-400">{{ result.errors|length }}</p>
					</div>
				</div>

				{% if result.errors|length > 0 %}
					<div class="mt-3">
						<p class="text-sm font-medium text-red-600 dark:text-red-400 mb-2">Líneas con error:</p>
						<ul class="space-y-1">
							{% for error in result.errors %}
								<li class="text-xs text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-700 rounded px-3 py-1">{{ error }}</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}
			</div>
		{% endif %}

		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
			<h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Subir archivo CSV</h2>
			<form method="post" enctype="multipart/form-data" class="space-y-4">
				<div>
					<label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
						Archivo CSV <span class="text-red-600">*</span>
					</label>
					<input type="file" name="csv_file" accept=".csv" required
						class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 dark:bg-gray-700 dark:border-gray-600 focus:outline-none file:mr-4 file:py-2 file:px-4 file:rounded-l-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-gray-600 dark:file:text-gray-200">
				</div>
				<div class="flex gap-3 pt-2">
					<button type="submit"
						class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700">
						Importar estudiantes
					</button>
					<a href="{{ path('admin_reports_index') }}"
						class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-700 dark:text-white dark:border-gray-600 dark:hover:bg-gray-600">
						Cancelar
					</a>
				</div>
			</form>
		</div>

	</div>
</div>
{% endblock %}
