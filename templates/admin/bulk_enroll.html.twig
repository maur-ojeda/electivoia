{% extends 'base.html.twig' %}
{% block title %}Inscripción Masiva — Admin{% endblock %}

{% block content %}
<div class="mb-6">
	<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Inscripción Masiva</h1>
	<p class="text-sm text-gray-500 dark:text-gray-400">Inscribe a todos los estudiantes de un grado en un curso de una sola vez.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

	<div class="lg:col-span-1">
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 sticky top-20">
			<h3 class="font-semibold text-sm text-gray-900 dark:text-white mb-3">¿Cómo funciona?</h3>
			<ol class="space-y-2 text-sm text-gray-600 dark:text-gray-400 list-decimal list-inside">
				<li>Selecciona el curso destino</li>
				<li>Selecciona el grado (3M o 4M)</li>
				<li>Se inscriben todos los estudiantes activos de ese grado</li>
			</ol>
			<hr class="my-3 border-gray-200 dark:border-gray-700">
			<div class="text-xs space-y-1 text-gray-500 dark:text-gray-400">
				<p>• Se omiten alumnos ya inscritos</p>
				<p>• Se respeta el cupo máximo del curso</p>
				<p>• Se respeta la fecha límite de inscripción</p>
				<p>• Solo cursos activos aparecen en la lista</p>
			</div>
		</div>
	</div>

	<div class="lg:col-span-2 space-y-6">

		{% if result is not null %}
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow border-l-4 {{ result.rejected == 0 ? 'border-green-500' : 'border-yellow-400' }} p-4">
				<h3 class="font-semibold text-gray-900 dark:text-white mb-3">
					Resultado: {{ result.grade }} → {{ result.course.name }}
				</h3>
				<div class="grid grid-cols-3 gap-3">
					<div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-center">
						<p class="text-xs text-gray-500 dark:text-gray-400">Inscritos</p>
						<p class="text-2xl font-bold text-green-600 dark:text-green-400">{{ result.enrolled }}</p>
					</div>
					<div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-center">
						<p class="text-xs text-gray-500 dark:text-gray-400">Ya inscritos</p>
						<p class="text-2xl font-bold text-blue-600 dark:text-blue-400">{{ result.skipped }}</p>
					</div>
					<div class="bg-gray-50 dark:bg-gray-700 rounded p-3 text-center">
						<p class="text-xs text-gray-500 dark:text-gray-400">Sin cupo</p>
						<p class="text-2xl font-bold text-red-600 dark:text-red-400">{{ result.rejected }}</p>
					</div>
				</div>
				{% if result.rejected > 0 %}
					<p class="text-xs text-yellow-600 dark:text-yellow-400 mt-3">
						⚠ {{ result.rejected }} estudiante(s) no pudieron inscribirse por falta de cupo. Considera aumentar la capacidad del curso.
					</p>
				{% endif %}
			</div>
		{% endif %}

		<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
			<h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Seleccionar curso y grado</h2>
			<form method="post" class="space-y-4">
				<div>
					<label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
						Curso destino <span class="text-red-600">*</span>
					</label>
					<select name="course_id"
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
						required>
						<option value="">— Seleccionar curso —</option>
						{% for course in courses %}
							<option value="{{ course.id }}">
								{{ course.name }}
								{% if course.category %}({{ course.category.name }}){% endif %}
								— {{ course.maxCapacity }} cupos
							</option>
						{% endfor %}
					</select>
				</div>

				<div>
					<label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
						Grado <span class="text-red-600">*</span>
					</label>
					<select name="grade"
						class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
						required>
						<option value="">— Seleccionar grado —</option>
						{% for grade in grades %}
							<option value="{{ grade }}">{{ grade == '3M' ? 'Tercer Medio (3M)' : 'Cuarto Medio (4M)' }}</option>
						{% endfor %}
					</select>
				</div>

				<div class="flex gap-3 pt-2">
					<button type="submit"
						class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700"
						data-controller="confirm"
						data-action="click->confirm#confirm"
						data-confirm-message-value="¿Confirmas la inscripción masiva? Esta acción inscribirá a todos los estudiantes del grado seleccionado.">
						Inscribir masivamente
					</button>
					<a href="{{ path('admin_reports_index') }}"
						class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-700 dark:text-white dark:border-gray-600 dark:hover:bg-gray-600">
						Cancelar
					</a>
				</div>
			</form>
		</div>

	</div>
</div>
{% endblock %}
