{% extends 'base.html.twig' %}
{% block title %}Período de Inscripción — ElectivoIA{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-6">
	<a href="{{ path('admin') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">← Volver</a>
	<div>
		<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Período de Inscripción</h1>
		<p class="text-sm text-gray-500 dark:text-gray-400">{{ school.name }}</p>
	</div>
</div>

{% if school.enrollmentOpen %}
	<div class="flex items-center p-4 mb-6 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400" role="alert">
		<svg class="shrink-0 w-4 h-4 me-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
		</svg>
		<span>Las inscripciones están <strong>abiertas</strong>.
			{% if school.enrollmentStart %} Apertura: {{ school.enrollmentStart|date('d/m/Y H:i') }}.{% endif %}
			{% if school.enrollmentEnd %} Cierre: {{ school.enrollmentEnd|date('d/m/Y H:i') }}.{% endif %}
		</span>
	</div>
{% else %}
	<div class="flex items-center p-4 mb-6 text-sm text-yellow-800 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-400" role="alert">
		<svg class="shrink-0 w-4 h-4 me-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-2.693-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
		</svg>
		<span>Las inscripciones están <strong>cerradas</strong>.
			{% if school.enrollmentStart %} Apertura: {{ school.enrollmentStart|date('d/m/Y H:i') }}.{% endif %}
			{% if school.enrollmentEnd %} Cierre: {{ school.enrollmentEnd|date('d/m/Y H:i') }}.{% endif %}
		</span>
	</div>
{% endif %}

<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 max-w-lg">
	<h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Configurar ventana de inscripciones</h2>
	<form method="post" class="space-y-4">
		<div>
			<div class="flex justify-between mb-1">
				<label class="text-sm font-medium text-gray-900 dark:text-white">Inicio inscripciones</label>
				<span class="text-xs text-gray-500 dark:text-gray-400">Opcional — deja vacío para sin restricción</span>
			</div>
			<input type="datetime-local" name="enrollmentStart"
				class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
				value="{{ school.enrollmentStart ? school.enrollmentStart|date('Y-m-d\\TH:i') : '' }}">
		</div>
		<div>
			<div class="flex justify-between mb-1">
				<label class="text-sm font-medium text-gray-900 dark:text-white">Cierre inscripciones</label>
				<span class="text-xs text-gray-500 dark:text-gray-400">Opcional — deja vacío para sin restricción</span>
			</div>
			<input type="datetime-local" name="enrollmentEnd"
				class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
				value="{{ school.enrollmentEnd ? school.enrollmentEnd|date('Y-m-d\\TH:i') : '' }}">
		</div>
		<div class="flex gap-3 pt-2">
			<button type="submit"
				class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700">
				Guardar período
			</button>
			<button type="button"
				class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-4 py-2.5 dark:bg-gray-700 dark:text-white dark:border-gray-600 dark:hover:bg-gray-600"
				onclick="document.querySelector('[name=enrollmentStart]').value='';document.querySelector('[name=enrollmentEnd]').value=''">
				Limpiar fechas
			</button>
		</div>
	</form>
</div>
{% endblock %}
