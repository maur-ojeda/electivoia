{% extends 'base.html.twig' %}
{% block title %}Mi Dashboard — ElectivoIA{% endblock %}

{% block content %}
<div class="mb-6">
	<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Hola, {{ student.fullName }} 👋</h1>
	<p class="text-gray-500 dark:text-gray-400 text-sm mt-1">
		{{ student.grade }}
		{% if student.averageGrade %}· Promedio: <strong>{{ student.averageGrade|number_format(1) }}</strong>{% endif %}
	</p>
</div>

{# Stats #}
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
	<div class="bg-white rounded-lg shadow p-5 dark:bg-gray-800">
		<p class="text-sm text-gray-500 dark:text-gray-400">Cursos inscritos</p>
		<p class="text-3xl font-bold text-blue-600 dark:text-blue-400 mt-1">{{ totalCourses }}</p>
	</div>
	<div class="bg-white rounded-lg shadow p-5 dark:bg-gray-800">
		<p class="text-sm text-gray-500 dark:text-gray-400">Asistencia promedio</p>
		{% if avgAttendance is not null %}
			<p class="text-3xl font-bold mt-1 {{ avgAttendance >= 75 ? 'text-green-600 dark:text-green-400' : (avgAttendance >= 50 ? 'text-yellow-500' : 'text-red-600 dark:text-red-400') }}">
				{{ avgAttendance }}%
			</p>
		{% else %}
			<p class="text-3xl font-bold text-gray-300 dark:text-gray-600 mt-1">—</p>
		{% endif %}
	</div>
	<div class="bg-white rounded-lg shadow p-5 dark:bg-gray-800">
		<p class="text-sm text-gray-500 dark:text-gray-400">Áreas de interés</p>
		<p class="text-3xl font-bold text-purple-600 dark:text-purple-400 mt-1">
			{{ student.interestProfile ? student.interestProfile.interests|length : 0 }}
		</p>
	</div>
</div>

{# Quick links #}
<div class="flex flex-wrap gap-3 mb-8">
	<a href="{{ path('student_courses') }}"
		class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700">
		Explorar cursos
	</a>
	<a href="{{ path('student_enrollments') }}"
		class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-4 py-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700">
		Mis cursos
	</a>
	<a href="{{ path('student_attendance') }}"
		class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-4 py-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700">
		Mi asistencia
	</a>
	<a href="{{ path('student_profile') }}"
		class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-4 py-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700">
		Mis intereses
	</a>
</div>

{# Course status #}
{% if courseStats|length > 0 %}
	<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Estado de mis cursos</h2>
	<div class="space-y-3">
		{% for item in courseStats %}
			{% set borderColor = item.percentage is null ? 'border-gray-200 dark:border-gray-700' : (item.percentage >= 75 ? 'border-green-500' : (item.percentage >= 50 ? 'border-yellow-400' : 'border-red-500')) %}
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow border-l-4 {{ borderColor }} p-4 flex justify-between items-center">
				<div>
					<p class="font-medium text-gray-900 dark:text-white">{{ item.course.name }}</p>
					{% if item.course.teacher %}
						<p class="text-xs text-gray-500 dark:text-gray-400">Prof. {{ item.course.teacher.fullName }}</p>
					{% endif %}
				</div>
				<div class="text-right">
					{% if item.percentage is not null %}
						{% set textColor = item.percentage >= 75 ? 'text-green-600 dark:text-green-400' : (item.percentage >= 50 ? 'text-yellow-500' : 'text-red-600 dark:text-red-400') %}
						<p class="text-xl font-bold {{ textColor }}">{{ item.percentage }}%</p>
						<p class="text-xs text-gray-400 dark:text-gray-500">{{ item.attended }}/{{ item.sessions }} sesiones</p>
					{% else %}
						<p class="text-xs text-gray-400 dark:text-gray-500">Sin sesiones aún</p>
					{% endif %}
				</div>
			</div>
		{% endfor %}
	</div>
{% else %}
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-10 text-center">
		<p class="text-gray-500 dark:text-gray-400 mb-4">Aún no estás inscrito en ningún curso.</p>
		<a href="{{ path('student_courses') }}"
			class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700">
			Explorar cursos disponibles
		</a>
	</div>
{% endif %}
{% endblock %}
