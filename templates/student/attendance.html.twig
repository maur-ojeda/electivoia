{% extends 'base.html.twig' %}
{% block title %}Mi Asistencia — ElectivoIA{% endblock %}

{% block content %}
<div class="mb-6">
	<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Mi Asistencia</h1>
	<p class="text-sm text-gray-500 dark:text-gray-400">Resumen de asistencia por curso inscrito.</p>
</div>

{% if attendanceData|length == 0 %}
	<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-12 text-center">
		<p class="text-gray-500 dark:text-gray-400 mb-4">No tienes cursos inscritos aún.</p>
		<a href="{{ path('student_courses') }}"
			class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700">
			Explorar cursos disponibles
		</a>
	</div>
{% else %}
	<div class="space-y-5">
		{% for item in attendanceData %}
			{% set borderColor = item.percentage is null ? 'border-gray-200 dark:border-gray-700' : (item.percentage >= 75 ? 'border-green-500' : (item.percentage >= 50 ? 'border-yellow-400' : 'border-red-500')) %}
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow border-l-4 {{ borderColor }} p-5">
				<div class="flex justify-between items-start">
					<div>
						<h3 class="font-bold text-base text-gray-900 dark:text-white">{{ item.course.name }}</h3>
						{% if item.course.teacher %}
							<p class="text-sm text-gray-500 dark:text-gray-400">Profesor: {{ item.course.teacher.fullName }}</p>
						{% endif %}
					</div>
					<div class="text-right">
						{% if item.percentage is not null %}
							{% set textColor = item.percentage >= 75 ? 'text-green-600 dark:text-green-400' : (item.percentage >= 50 ? 'text-yellow-500' : 'text-red-600 dark:text-red-400') %}
							<span class="text-2xl font-bold {{ textColor }}">{{ item.percentage }}%</span>
							<p class="text-xs text-gray-400 dark:text-gray-500">asistencia</p>
						{% else %}
							<span class="text-sm text-gray-400 dark:text-gray-500">Sin registros</span>
						{% endif %}
					</div>
				</div>

				{% if item.total > 0 %}
					<div class="flex gap-3 mt-3 flex-wrap">
						<span class="bg-green-100 text-green-700 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">✓ {{ item.present }} presentes</span>
						<span class="bg-red-100 text-red-700 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">✗ {{ item.absent }} ausentes</span>
						<span class="bg-yellow-100 text-yellow-700 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">~ {{ item.justified }} justificados</span>
					</div>

					{% if item.records|length > 0 %}
						<details class="mt-4">
							<summary class="cursor-pointer text-sm text-blue-600 hover:underline dark:text-blue-400">
								Ver detalle de sesiones ({{ item.total }})
							</summary>
							<div class="mt-3 overflow-x-auto">
								<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
									<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
										<tr>
											<th class="px-4 py-2">Fecha</th>
											<th class="px-4 py-2">Estado</th>
										</tr>
									</thead>
									<tbody>
										{% for record in item.records %}
											<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
												<td class="px-4 py-2">{{ record.date|date('d/m/Y') }}</td>
												<td class="px-4 py-2">
													{% if record.status == 'present' %}
														<span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Presente</span>
													{% elseif record.status == 'absent' %}
														<span class="bg-red-100 text-red-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-red-900 dark:text-red-300">Ausente</span>
													{% else %}
														<span class="bg-yellow-100 text-yellow-700 text-xs font-medium px-2 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">Justificado</span>
													{% endif %}
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</details>
					{% endif %}
				{% else %}
					<p class="text-sm text-gray-400 dark:text-gray-500 mt-2">El profesor aún no ha registrado sesiones para este curso.</p>
				{% endif %}
			</div>
		{% endfor %}
	</div>

	<div class="mt-6 flex gap-4">
		<a href="{{ path('student_enrollments') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">← Mis Cursos</a>
		<a href="{{ path('student_courses') }}" class="text-blue-600 hover:underline text-sm dark:text-blue-400">Explorar cursos</a>
	</div>
{% endif %}
{% endblock %}
