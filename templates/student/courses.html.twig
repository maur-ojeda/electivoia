{% extends 'base.html.twig' %}
{% block title %}Cursos Disponibles — ElectivoIA{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
	<div>
		<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Cursos Disponibles</h1>
		<p class="text-sm text-gray-500 dark:text-gray-400">Hola, {{ app.user.fullName }} · {{ app.user.grade }}</p>
	</div>
</div>

{# Enrollment period banner #}
{% if not enrollmentOpen %}
	<div class="flex items-center p-4 mb-6 text-sm text-yellow-800 border border-yellow-300 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300 dark:border-yellow-800" role="alert">
		<svg class="shrink-0 inline w-4 h-4 mr-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
		<div>
			<span class="font-semibold">El período de inscripción está cerrado.</span>
			{% if school and school.enrollmentStart and school.enrollmentStart > date() %}
				<span class="ml-1">Las inscripciones abren el {{ school.enrollmentStart|date('d/m/Y') }} a las {{ school.enrollmentStart|date('H:i') }}.</span>
			{% elseif school and school.enrollmentEnd %}
				<span class="ml-1">El plazo cerró el {{ school.enrollmentEnd|date('d/m/Y') }} a las {{ school.enrollmentEnd|date('H:i') }}.</span>
			{% endif %}
		</div>
	</div>
{% elseif school and school.enrollmentEnd %}
	<div class="flex items-center p-4 mb-4 text-sm text-blue-800 border border-blue-300 rounded-lg bg-blue-50 dark:bg-gray-800 dark:text-blue-400 dark:border-blue-800">
		<svg class="shrink-0 inline w-4 h-4 mr-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
		Inscripciones abiertas hasta el <strong class="ml-1">{{ school.enrollmentEnd|date('d/m/Y') }}</strong>&nbsp;a las {{ school.enrollmentEnd|date('H:i') }}.
	</div>
{% endif %}

{# Search bar #}
<form method="GET" class="mb-8 flex flex-wrap gap-3 items-end">
	<label class="flex items-center gap-2 cursor-pointer">
		<input type="checkbox" name="available" value="1"
			class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600"
			{% if showAvailableOnly %}checked{% endif %} onchange="this.form.submit()">
		<span class="text-sm text-gray-700 dark:text-gray-300">Solo con cupos</span>
	</label>
	<select name="category" onchange="this.form.submit()"
		class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
		<option value="">Todas las áreas</option>
		{% for cat in allCategories %}
			<option value="{{ cat.id }}" {% if cat.id == selectedCategory %}selected{% endif %}>{{ cat.name }}</option>
		{% endfor %}
	</select>
	<div class="flex flex-1 gap-0">
		<input type="text" name="q" value="{{ searchQuery }}"
			placeholder="Buscar por nombre, descripción u horario…"
			class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-l-lg focus:ring-blue-500 focus:border-blue-500 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
		<button type="submit"
			class="text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-r-lg text-sm px-4 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
		</button>
	</div>
</form>

{# Recommended courses #}
{% if recommendations|length > 0 %}
	<div class="mb-8">
		<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
			<span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">IA</span>
			Cursos recomendados para ti
		</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{% for item in recommendations %}
				{% set course = item.course %}
				{% set img = category_image_map[course.category.name]|default('default') %}
				<div class="bg-white border-2 border-blue-300 rounded-lg shadow hover:border-blue-500 transition-colors dark:bg-gray-800 dark:border-blue-700">
					<img src="{{ asset('build/images/course/' ~ img ~ '.png') }}" alt="{{ course.name }}" class="rounded-t-lg w-full h-36 object-cover">
					<div class="p-4">
						<div class="flex gap-1 flex-wrap mb-2">
							<span class="bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400">{{ course.category.area }}</span>
							<span class="bg-blue-100 text-blue-700 text-xs px-2 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">{{ course.category.name }}</span>
						</div>
						<h3 class="font-bold text-sm text-gray-900 dark:text-white leading-tight mb-1">{{ course.name }}</h3>
						<p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-2 mb-2">{{ course.description }}</p>
						<p class="text-xs text-gray-700 dark:text-gray-300">{{ course.teacher.fullName }} · {{ enrollmentCounts[course.id] ?? 0 }}/{{ course.maxCapacity }}</p>
						{% if course.schedule %}<p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">🕐 {{ course.schedule }}</p>{% endif %}
						<p class="text-xs text-yellow-600 dark:text-yellow-400 mt-1">★ {{ item.reasons|join(', ') }}</p>
						<div class="mt-3">
							{% if course.id in enrolledCourseIds %}
								<span class="block text-center text-xs text-green-700 bg-green-100 rounded px-2 py-1.5 mb-1 dark:bg-green-900 dark:text-green-300">✓ Inscrito</span>
								<form method="post" action="{{ path('student_unenroll', {id: course.id}) }}">
									<button type="submit"
										class="w-full text-red-700 border border-red-300 hover:bg-red-50 text-xs font-medium rounded-lg px-3 py-1.5 dark:border-red-700 dark:text-red-400 dark:hover:bg-gray-700"
										onclick="return confirm('¿Darse de baja de {{ course.name }}?')">
										Dar de baja
									</button>
								</form>
							{% else %}
								<form method="post" action="{{ path('student_enroll', {id: course.id}) }}">
									<button type="submit"
										class="w-full text-white bg-blue-700 hover:bg-blue-800 text-xs font-medium rounded-lg px-3 py-2 dark:bg-blue-600 dark:hover:bg-blue-700">
										Inscribirse
									</button>
								</form>
							{% endif %}
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endif %}

{# All courses #}
{% set recommendedCourseIds = recommendations|map(r => r.course.id) %}
{% set otherCourses = courses|filter(c => c.id not in recommendedCourseIds) %}

{% if otherCourses|length > 0 %}
	{% if recommendations|length > 0 %}
		<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Todos los cursos</h2>
	{% endif %}
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
		{% for course in otherCourses %}
			{% set img = category_image_map[course.category.name]|default('default') %}
			<div class="bg-white border border-gray-200 rounded-lg shadow hover:shadow-md transition-shadow dark:bg-gray-800 dark:border-gray-700">
				<img src="{{ asset('build/images/course/' ~ img ~ '.png') }}" alt="{{ course.name }}" class="rounded-t-lg w-full h-36 object-cover">
				<div class="p-4">
					<div class="flex gap-1 flex-wrap mb-2">
						<span class="bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400">{{ course.category.area }}</span>
						<span class="bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400">{{ course.category.name }}</span>
					</div>
					<h3 class="font-bold text-sm text-gray-900 dark:text-white leading-tight mb-1">{{ course.name }}</h3>
					<p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-2 mb-2">{{ course.description }}</p>
					<p class="text-xs text-gray-700 dark:text-gray-300">{{ course.teacher.fullName }} · {{ enrollmentCounts[course.id] ?? 0 }}/{{ course.maxCapacity }}</p>
					{% if course.schedule %}<p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">🕐 {{ course.schedule }}</p>{% endif %}
					<div class="mt-3">
						{% if course.id in enrolledCourseIds %}
							<span class="block text-center text-xs text-green-700 bg-green-100 rounded px-2 py-1.5 mb-1 dark:bg-green-900 dark:text-green-300">✓ Inscrito</span>
							<form method="post" action="{{ path('student_unenroll', {id: course.id}) }}">
								<button type="submit"
									class="w-full text-red-700 border border-red-300 hover:bg-red-50 text-xs font-medium rounded-lg px-3 py-1.5 dark:border-red-700 dark:text-red-400 dark:hover:bg-gray-700"
									onclick="return confirm('¿Darse de baja de {{ course.name }}?')">
									Dar de baja
								</button>
							</form>
						{% else %}
							<form method="post" action="{{ path('student_enroll', {id: course.id}) }}">
								<button type="submit"
									class="w-full text-white bg-gray-700 hover:bg-gray-800 text-xs font-medium rounded-lg px-3 py-2 dark:bg-gray-600 dark:hover:bg-gray-500">
									Inscribirse
								</button>
							</form>
						{% endif %}
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
{% endif %}

{% if courses|length == 0 %}
	<div class="text-center py-16 text-gray-500 dark:text-gray-400">
		<p class="text-lg">No se encontraron cursos con los filtros aplicados.</p>
		<a href="{{ path('student_courses') }}"
			class="mt-4 inline-block text-blue-600 hover:underline dark:text-blue-400">Limpiar filtros</a>
	</div>
{% endif %}

{# Chatbot widget #}
<div data-controller="chatbot"
	data-chatbot-url-value="{{ path('api_chatbot') }}"
	data-chatbot-clear-url-value="{{ path('api_chatbot_clear') }}"
	class="fixed bottom-6 right-6 z-50">
	<button data-action="click->chatbot#toggle" title="Asistente IA"
		class="flex items-center justify-center w-14 h-14 text-white bg-blue-700 hover:bg-blue-800 rounded-full shadow-lg dark:bg-blue-600 dark:hover:bg-blue-700">
		<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
	</button>
	<div data-chatbot-target="widget" class="hidden absolute bottom-16 right-0 w-80 bg-white border border-gray-200 rounded-lg shadow-2xl dark:bg-gray-800 dark:border-gray-700">
		<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 bg-blue-700 text-white rounded-t-lg dark:border-gray-600">
			<span class="font-semibold text-sm">🤖 Asistente de Cursos</span>
			<div class="flex gap-1">
				<button data-action="click->chatbot#clearHistory" class="hover:bg-blue-800 rounded p-1 text-xs" title="Limpiar chat">↺</button>
				<button data-action="click->chatbot#toggle" class="hover:bg-blue-800 rounded p-1 text-xs">✕</button>
			</div>
		</div>
		<div data-chatbot-target="messages" class="h-60 overflow-y-auto p-3 space-y-2 bg-gray-50 dark:bg-gray-900">
			<div class="flex items-start gap-2">
				<div class="bg-gray-200 dark:bg-gray-700 rounded-lg px-3 py-2 text-sm text-gray-800 dark:text-gray-200 max-w-[90%]">
					¡Hola! Soy tu asistente para cursos electivos. ¿En qué puedo ayudarte? 🌟
				</div>
			</div>
		</div>
		<form data-action="submit->chatbot#send" class="flex gap-2 p-3 border-t border-gray-200 dark:border-gray-700">
			<input data-chatbot-target="input" type="text" placeholder="Escribe tu pregunta…"
				class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
			<button type="submit"
				class="text-white bg-blue-700 hover:bg-blue-800 rounded-lg px-3 py-2 text-sm dark:bg-blue-600 dark:hover:bg-blue-700">→</button>
		</form>
	</div>
</div>

{# Interests link — the form lives in /student/profile #}
<div class="fixed bottom-6 left-6 z-40">
	<a href="{{ path('student_profile') }}"
		class="inline-flex items-center gap-2 text-white bg-purple-700 hover:bg-purple-800 font-medium rounded-lg text-sm px-4 py-2.5 shadow-lg dark:bg-purple-600 dark:hover:bg-purple-700">
		<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
		Mis intereses
	</a>
</div>
{% endblock %}
